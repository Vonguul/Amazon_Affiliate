---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import Disclosure from '../../components/Disclosure.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

// Related articles — internal cross-linking for SEO (keeps visitors on
// site longer, helps search engines understand the site's topic depth).
const allArticles = await getCollection('articles');
const related = allArticles
  .filter((a) => a.slug !== article.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.heroImage}
>
  <article class="article">
    <span class="article__category">{article.data.category}</span>
    <h1>{article.data.title}</h1>

    {article.data.heroImage && (
      <img src={article.data.heroImage} alt={article.data.title} class="article__hero" />
    )}

    <Disclosure />

    <div class="article__body">
      <Content />
    </div>

    {article.data.products.length > 0 && (
      <section>
        <h2>Featured Products</h2>
        <ul class="product-list">
          {article.data.products.map((p) => (
            <li class="product-card">
              {p.image && <img src={p.image} alt={p.name} class="product-card__image" />}
              <div>
                <p class="product-card__name">{p.name}</p>
                {p.note && <p class="product-card__note">{p.note}</p>}
                <AffiliateLink asin={p.asin} class="product-card__cta">
                  Check Price on Amazon
                </AffiliateLink>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <Disclosure />

    {related.length > 0 && (
      <section class="related-articles">
        <h2>More Organization Ideas</h2>
        <ul class="related-articles__list">
          {related.map((r) => (
            <li>
              <a href={`/articles/${r.slug}/`}>
                {r.data.heroImage && <img src={r.data.heroImage} alt={r.data.title} />}
                <span>{r.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
