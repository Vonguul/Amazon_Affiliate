---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout
  title="Vonguul Picks — Home Organization & Small-Space Living"
  description="Tested product picks and buying guides for home organization and small-space living."
>
  <h1>Vonguul Picks</h1>
  <p>Product picks and guides for home organization and small-space living.</p>

  <ul>
    {articles.map((article) => (
      <li>
        <a href={`/articles/${article.slug}/`}>{article.data.title}</a>
        <p>{article.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
